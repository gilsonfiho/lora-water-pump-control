	(text "ALIMENTACAO - 5 V (USB-C ou borne) -> +5V -> LDO 3V3"
		(exclude_from_sim no)
		(at 15 12 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "68a2189f-582b-4ac9-a701-86045eb2ca6a")
	)
	(text "Entrada externa SO 5 V (nao ligar 12 V!). Dois Schottky fazem o OR USB/borne: queda de ~0,3-0,5 V,\no que deixa o E220 abaixo de 5,0 V (potencia plena do T30D). TODO(hw): ideal diode + buck 12 V + bateria no hw-v0.2.\nLDO AP2112K-3.3: 600 mA min, Cin = Cout = 1 uF X5R/X7R (Datasheet Diodes, p.2). CC1/CC2 com 5k1 (UFP).\nEXT_PRESENT: divisor 100k/100k do borne (2,5 V no GPIO20). BAT_ADC sem bateria: pull-down de 100k."
		(exclude_from_sim no)
		(at 15 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9113dfc5-2da1-4094-84fe-89fbc21a7765")
	)

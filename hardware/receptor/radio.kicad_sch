	(text "TODO(hw): 470 uF e palpite;\nbancada usa 1000 uF"
		(exclude_from_sim no)
		(at 175 150 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "cfa4e14c-c086-4e5e-8a43-aaa7330744e4")
	)
	(text "!! O E220 TRANSMITE LOGO NO BOOT: NUNCA ENERGIZAR SEM ANTENA NO SMA DO MODULO !!\nA antena e o SMA-K do proprio modulo (Manual T30D, Tabela 2-2, p.5): nao ha SMA na PCB.\nPinos (Tabela 3-1, p.6): 1 M0, 2 M1, 3 RXD, 4 TXD, 5 AUX, 6 VCC, 7 GND; 8-11 furos de fixacao.\nUART/M0/M1/AUX em 3,3 V. VCC em 5 V (>= 5,0 V para potencia plena): 620 mA de pico em TX.\nEntrada maxima do RX: +10 dBm (nos a >= 3 m na bancada).\nPull-ups de 4-10 k em TXD/AUX so para MCU de 5 V (Tabela 4-1, p.7): DNP aqui (MCU de 3,3 V)."
		(exclude_from_sim no)
		(at 15 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d9f45ae1-aaf4-4e78-91b6-df5680288c36")
	)
